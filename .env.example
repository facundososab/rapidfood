# ==============================================================================
# Rapidfood environment template (safe to commit, no real secrets).
# Copy to the REPO ROOT as `.env`; every component reads it from there:
#   - docker-compose.yml  -> interpolates POSTGRES_* / BACKEND_PORT / UI_PORT
#   - Prisma CLI          -> reads `.env` from the working directory
#   - Django API          -> api/config/settings.py loads the repo-root `.env`
#   - Admin panel         -> ui/config/settings.py loads the repo-root `.env`
# ==============================================================================

# --- PostgreSQL: used by Prisma (single source of truth for the data layer)
#     and interpolated by docker-compose.yml for the `db` service. ------------
DATABASE_URL=postgresql://rapidfood:rapidfood@localhost:5432/rapidfood
POSTGRES_USER=rapidfood
POSTGRES_PASSWORD=rapidfood
POSTGRES_DB=rapidfood
POSTGRES_PORT=5432

# --- Django API (api/ — HTTP shell only; Django does NOT own the DB) ----------
# Change DJANGO_SECRET_KEY outside dev environments.
DJANGO_SECRET_KEY=dev-only-insecure-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- Admin panel (ui/) --------------------------------------------------------
# RAPIDFOOD_CLIENT: "mock" = in-memory seeded data (works standalone);
#                  "http"  = consume the real backend API.
RAPIDFOOD_CLIENT=mock
RAPIDFOOD_API_BASE_URL=http://localhost:8000
RAPIDFOOD_API_TOKEN=

# --- Host ports published by docker-compose -----------------------------------
BACKEND_PORT=8000
UI_PORT=8001

# --- Delivery module ---
# Get your key at https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=

# --- Supabase Auth (staff login for the admin panel / management API) -------
# Identity provider only: GoTrue issues JWTs (email+password); Django validates
# them (HS256 with SUPABASE_JWT_SECRET). The DB stays in Prisma-owned Postgres.
# Create the project at https://supabase.com/dashboard, then copy:
#   SUPABASE_URL                Project Settings -> API -> Project URL
#   SUPABASE_ANON_KEY           Project Settings -> API -> anon public key
#   SUPABASE_JWT_SECRET         Project Settings -> API -> JWT Secret
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Optional: only needed by the `create_staff` management command (admin API).
SUPABASE_SERVICE_ROLE_KEY=
