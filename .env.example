# PostgreSQL connection used by Prisma (single source of truth for the data layer).
# Also interpolated by docker-compose.yml for the `db` service.
DATABASE_URL=postgresql://rapidfood:rapidfood@localhost:5432/rapidfood

# Django (HTTP shell only — Django does NOT own the database; Prisma does)
DJANGO_SECRET_KEY=dev-only-insecure-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# docker-compose interpolation
POSTGRES_USER=rapidfood
POSTGRES_PASSWORD=rapidfood
POSTGRES_DB=rapidfood
POSTGRES_PORT=5432
