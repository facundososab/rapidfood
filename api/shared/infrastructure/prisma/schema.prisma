// Rapidfood - single source of truth for the data layer (ADR-7/ADR-8).
// Django owns NO tables; `prisma migrate dev` owns all migrations.
// NOTE: comments are ASCII-only (Windows cp1252 limitation of the generator).

generator client {
  provider  = "prisma-client-py"
  interface = "sync"
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums: ONLY doc-fixed vocabularies (native PG enums are costly to alter) ---

enum OrderStatus {
  DRAFT
  PENDING
  PAID
  CONFIRMED
  IN_PREPARATION
  READY
  DELIVERED
  PICKED_UP
  CANCELLED
}

enum OrderOrigin {
  IN_PLACE
  AGENT
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum PaymentType {
  CASH
  ONLINE
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
  EXPIRED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// --- Models: snake_case via @map / @@map ---

model BusinessConfiguration {
  id            String          @id @default(uuid()) @map("business_id") @db.Uuid
  businessName  String          @map("business_name")
  minOrder      Decimal         @map("min_order") @db.Decimal(10, 2)
  shippingCost  Decimal         @map("shipping_cost") @db.Decimal(10, 2)
  availableZone Json?           @map("available_zone")
  businessHours BusinessHours[]
  addresses     Address[]
  orders        Order[]
  deliveryPricingConfiguration DeliveryPricingConfiguration?

  @@map("business_configuration")
}

model BusinessHours {
  id               String                @id @default(uuid()) @map("business_hours_id") @db.Uuid
  openWeekDay      WeekDay               @map("open_week_day")
  openFromHour     String                @map("open_from_hour") // "HH:MM" (Prisma lacks TIME type)
  openToHour       String                @map("open_to_hour")
  businessConfigId String                @map("business_config_id") @db.Uuid
  businessConfig   BusinessConfiguration @relation(fields: [businessConfigId], references: [id], onDelete: Cascade)

  @@map("business_hours")
}

model Address {
  id               String                @id @default(uuid()) @map("address_id") @db.Uuid
  street           String
  streetNumber     String                @map("street_number")
  floor            String?
  apartment        String?
  city             String
  province         String
  postalCode       String?               @map("postal_code")
  businessConfigId String                @map("business_config_id") @db.Uuid
  businessConfig   BusinessConfiguration @relation(fields: [businessConfigId], references: [id], onDelete: Cascade)
  orders           Order[]
  // inverse: address can be origin for at most one delivery pricing config
  deliveryPricingOriginFor DeliveryPricingConfiguration? @relation("DeliveryPricingOriginAddress")

  @@map("address")
}

model Client {
  id            String         @id @default(uuid()) @map("client_id") @db.Uuid
  name          String
  lastName      String         @map("last_name")
  phoneNumber   String         @unique @map("phone_number")
  conversations Conversation[]
  orders        Order[]

  @@map("client")
}

model Conversation {
  id               String    @id @default(uuid()) @map("conversation_id") @db.Uuid
  overallSentiment String?   @map("overall_sentiment")
  lastIntent       String?   @map("last_intent")
  channel          String    @default("WHATSAPP")
  clientId         String?   @map("client_id") @db.Uuid
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  messages         Message[]
  orders           Order[]

  @@map("conversation")
}

model Message {
  id             String       @id @default(uuid()) @map("message_id") @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // USER | AGENT | SYSTEM - open vocab -> String
  content        String
  detectedIntent String?      @map("detected_intent")
  sentiment      String?
  status         String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("message")
}

model Order {
  id              String          @id @default(uuid()) @map("order_id") @db.Uuid
  estimatedTime   Int?            @map("estimated_time") // minutes (RN-025/037)
  deliveryType    DeliveryType?   @map("delivery_type") // null until REQ-033
  paymentType     PaymentType?    @map("payment_type") // null until REQ-033
  status          OrderStatus     @default(DRAFT)
  origin          OrderOrigin     @default(IN_PLACE) // IN_PLACE (POS) | AGENT (WhatsApp/IA)
  subtotal        Decimal         @default(0) @db.Decimal(10, 2)
  discount        Decimal         @default(0) @db.Decimal(10, 2)
  shippingCost    Decimal?        @map("shipping_cost") @db.Decimal(10, 2)
  totalAmount     Decimal?        @map("total_amount") @db.Decimal(10, 2)
  clientId        String?         @map("client_id") @db.Uuid
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  addressId       String?         @map("address_id") @db.Uuid // nullable: BORRADOR needs no address (RN-020)
  address         Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  conversationId  String?         @map("conversation_id") @db.Uuid // RN-030: order references its conversation; RN-031: 1 conv -> many orders
  conversation    Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  appliedCouponId  String?               @map("applied_coupon_id") @db.Uuid // Optional coupon applied
  confirmedAt      DateTime?             @map("confirmed_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  // nullable until all order creation paths are updated to supply businessConfigId
  businessConfigId String?               @map("business_config_id") @db.Uuid
  businessConfig   BusinessConfiguration? @relation(fields: [businessConfigId], references: [id], onDelete: Restrict)
  lines            OrderLine[]
  appliedCoupons   AppliedCoupon[]
  payments         Payment[]

  @@index([clientId])
  @@index([status])
  @@index([conversationId])
  @@index([businessConfigId, deliveryType, status, createdAt])
  @@map("order")
}

model OrderLine {
  id         String    @id @default(uuid()) @map("order_line_id") @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String    @map("product_id") @db.Uuid
  product    Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Int       @map("quantity") // quantity (was amount)
  unitPrice  Decimal?  @map("unit_price") @db.Decimal(10, 2) // snapshot - NULL in DRAFT, frozen at confirm
  subtotal   Decimal   @db.Decimal(10, 2) // recomputed on draft edits
  discountId String?   @map("discount_id") @db.Uuid
  discount   Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  @@unique([orderId, productId]) // one line per product
  @@index([productId])
  @@map("order_line")
}

model Product {
  id          String      @id @default(uuid()) @map("product_id") @db.Uuid
  name        String
  description String
  imageUrl    String?     @map("image_url")
  available   Boolean     @default(true)
  categoryId  String      @map("category_id") @db.Uuid // diagram "1..1": product belongs to exactly 1 category
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  prices      Price[]
  orderLines  OrderLine[]
  discounts   Discount[]

  @@index([categoryId])
  @@map("product")
}

model Price {
  id        String   @id @default(uuid()) @map("price_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sinceDate DateTime @map("since_date")
  price     Decimal  @db.Decimal(10, 2)

  @@index([productId, sinceDate]) // current price = max(since_date) <= now
  @@map("price")
}

model Category {
  id          String    @id @default(uuid()) @map("category_id") @db.Uuid
  description String
  products    Product[]

  @@map("category")
}

model Discount {
  id         String      @id @default(uuid()) @map("discount_id") @db.Uuid
  percentage Decimal     @db.Decimal(5, 2) // 0-100
  productId  String?     @map("product_id") @db.Uuid
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]

  @@map("discount")
}

model Coupon {
  id               String          @id @default(uuid()) @map("coupon_id") @db.Uuid
  couponCode       String          @unique @map("coupon_code")
  type             String // FIXED_AMOUNT | PERCENTAGE | ... - open vocab -> String
  amount           Decimal          @db.Decimal(10, 2)
  minOrderAmount   Decimal?         @map("min_order_amount") @db.Decimal(10, 2)
  availableUses    Int              @map("available_uses")
  dateOfExpiration DateTime?        @map("date_of_expiration")
  isActive         Boolean          @default(true) @map("is_active")
  appliedCoupons   AppliedCoupon[]

  @@map("coupon")
}

model AppliedCoupon {
  id               String    @id @default(uuid()) @map("applied_coupon_id") @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  couponId         String?   @map("coupon_id") @db.Uuid // nullable: snapshot survives coupon deletion
  coupon           Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode       String    @map("coupon_code") // FULL coupon snapshot
  type             String // frozen at application time
  amount           Decimal   @db.Decimal(10, 2)
  discountAmount   Decimal   @map("discount_amount") @db.Decimal(10, 2)
  availableUses    Int       @map("available_uses")
  dateOfExpiration DateTime? @map("date_of_expiration")
  appliedAt        DateTime  @default(now()) @map("applied_at")

  @@index([orderId])
  @@map("applied_coupon")
}

model Payment {
  id         String        @id @default(uuid()) @map("payment_id") @db.Uuid
  orderId    String        @map("order_id") @db.Uuid
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   String
  externalId String?       @map("external_id")
  status     PaymentStatus @default(PENDING)
  amount     Decimal       @db.Decimal(10, 2)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("payment")
}

// --- Delivery module models ---

// Per-restaurant delivery pricing configuration (1:1 with BusinessConfiguration).
// Stores all pricing rules; weekday multipliers are normalized in DeliveryWeekdayPricingRule.
model DeliveryPricingConfiguration {
  id                       String                @id @default(uuid()) @map("delivery_pricing_configuration_id") @db.Uuid

  businessConfigId         String                @unique @map("business_config_id") @db.Uuid
  businessConfig           BusinessConfiguration @relation(fields: [businessConfigId], references: [id], onDelete: Cascade)

  // The restaurant address used as the route origin for delivery quotes
  originAddressId          String                @unique @map("origin_address_id") @db.Uuid
  originAddress            Address               @relation("DeliveryPricingOriginAddress", fields: [originAddressId], references: [id], onDelete: Restrict)

  pricePerKm               Decimal               @map("price_per_km") @db.Decimal(10, 2)

  highDemandThreshold      Int                   @map("high_demand_threshold")
  veryHighDemandThreshold  Int                   @map("very_high_demand_threshold")

  highDemandMultiplier     Decimal               @map("high_demand_multiplier") @db.Decimal(5, 2)
  veryHighDemandMultiplier Decimal               @map("very_high_demand_multiplier") @db.Decimal(5, 2)

  // Minutes window to look back when counting active delivery orders
  demandWindowMinutes      Int                   @map("demand_window_minutes")

  weekdayRules             DeliveryWeekdayPricingRule[]

  @@map("delivery_pricing_configuration")
}

// Per-day pricing multiplier (normalized; one row per weekday per restaurant).
model DeliveryWeekdayPricingRule {
  id                      String                       @id @default(uuid()) @map("delivery_weekday_pricing_rule_id") @db.Uuid

  deliveryPricingConfigId String                       @map("delivery_pricing_config_id") @db.Uuid
  deliveryPricingConfig   DeliveryPricingConfiguration @relation(fields: [deliveryPricingConfigId], references: [id], onDelete: Cascade)

  weekDay                 WeekDay                      @map("week_day")
  multiplier              Decimal                      @db.Decimal(5, 2)

  @@unique([deliveryPricingConfigId, weekDay])
  @@map("delivery_weekday_pricing_rule")
}
